# ──────────────────────────────────────────────────
# Revlane Signal Engine — Environment Variables
# Copy this file to .env.local and fill in your values
# ──────────────────────────────────────────────────

# ── Required: Bright Data API ──
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here

# ── Required: Bright Data Dataset IDs ──
BD_DATASET_ACTIVITY=gd_lyy3tktm25m4avu764
BD_DATASET_PROFILES=gd_l1viktl72bvl7bjuj0
BD_DATASET_WEB_SCRAPER=gd_m6gjtfmeh43we6cqc

# Optional prospect interpretation model (Groq). Defaults to a supported production model.
PROSPECT_RESEARCH_MODEL=openai/gpt-oss-120b

# ── Required: LinkedIn Authentication ──
# Get this from browser DevTools → Application → Cookies → linkedin.com → li_at
LINKEDIN_LI_AT=your_linkedin_li_at_cookie_here

# ── Optional: Bright Data Residential Proxy ──
BD_PROXY_URL=http://brd-customer-CUSTOMER_ID-zone-ZONE:PASSWORD@brd.superproxy.io:33335

# ── Optional: Google Sheets Export ──
# Service account credentials JSON (base64 encoded)
# 1. Create a service account at https://console.cloud.google.com
# 2. Enable the Google Sheets API
# 3. Download the JSON key file
# 4. Base64 encode it: base64 -w0 credentials.json
# 5. Paste the result below
GOOGLE_SHEETS_CREDENTIALS_BASE64=

# Optional: Default spreadsheet ID to append to (leave empty to create new)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Self-hosted direct SMTP verification identity. Use a hostname and sender
# address you control; configure the sending host's A/PTR/SPF records.
EMAIL_VERIFY_HELO=verify.revlane.io
EMAIL_VERIFY_MAIL_FROM=verify@revlane.io

# SMTP probe pacing. Sustained bursts from one IP are what gets a host onto a
# provider blocklist, and a blocklisted host fails quietly — every mailbox starts
# looking rejected. Raise only if you know the sending IP's reputation is solid.
EMAIL_VERIFY_CONCURRENCY=4
EMAIL_VERIFY_HOST_INTERVAL_MS=2000

# Gmail accounts to reconcile the CRM's "contacted" flag against, read over IMAP
# with App Passwords (needs 2-Step Verification on the account; no Google Cloud
# project, OAuth consent screen, or app verification involved). Read-only: the
# sync only ever reads Sent Mail. Add as many accounts as you send from.
GMAIL_ACCOUNTS=[{"email":"you@gmail.com","appPassword":"abcd efgh ijkl mnop"}]

# Profiles per day for the LinkedIn account used by worker.cjs.
DAILY_SCRAPE_LIMIT=400
# How many leads may sit in the post-LinkedIn enrichment stage at once (website
# crawl, email extraction, hook, CRM push). These never touch LinkedIn.
ENRICH_CONCURRENCY=3

# Isolated Case Study Hunter worker. Keep this low: the daily queue is designed
# around 5 messages, 3 follow-ups, and 5 warm engagement actions.
CASE_STUDY_DAILY_SCRAPE_LIMIT=150
CASE_STUDY_PROFILE_DELAY_MIN_MS=12000
CASE_STUDY_PROFILE_DELAY_MAX_MS=25000
CASE_STUDY_JOB_TITLES=Executive Coach,Business Coach,Leadership Coach,Career Coach,Life Coach,Health Coach,Wellness Coach,Performance Coach,Mindset Coach
# Optional locally. Docker resolves the app through the qualifier service.
APP_URL=http://localhost:3000

# Public origin of the separate client-only Vercel portal. Used to copy client links.
NEXT_PUBLIC_CLIENT_PORTAL_URL=https://your-client-portal.vercel.app
# Funnel Analyzer (server-side only)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-v4-flash
AGENTROUTER_FALLBACK_MODELS=

# Copy Studio (optional overrides; defaults to AGENTROUTER_*).
# Put secrets in .env.local or .env.docker.local, never in tracked files.
COPY_STUDIO_API_KEY=
COPY_STUDIO_BASE_URL=https://agentrouter.org/v1
COPY_STUDIO_MODEL=deepseek-v4-flash
COPY_STUDIO_TIMEOUT_MS=90000
