export type ProspectSegment = 'EXECUTIVE' | 'CAREER' | 'BUSINESS' | 'UNKNOWN';
export type FactState = 'OBSERVED' | 'INDICATED' | 'UNKNOWN' | 'NEGATIVE';
export type FactKey = 'independentBusiness' | 'paidOffer' | 'clientProof' | 'demandSignals' | 'funnelOpportunity' | 'marketingControl' | 'economics' | 'capacity' | 'targetMarket';
export type ProspectTier = 'A' | 'B' | 'C' | 'OUTSIDE_ICP';
export type ProspectEvidence = { url: string; excerpt: string; source: 'WEBSITE' | 'PROFILE' | 'MANUAL'; observedAt: string };
export type ProspectFact = { state: FactState; value: string; reason: string; evidence: ProspectEvidence[] };
export type ProspectReview = { facts: Partial<Record<FactKey, { state: FactState; note: string; url?: string }>>; segment?: string; contactOwnership?: string; contactEmail?: string; note?: string; reviewedAt?: string };
export type ProspectResearch = {
    followers?:AudienceEvidence|null;connections?:AudienceEvidence|null;targetLocationRequired?:boolean;
    version: number; researchedAt: string; engine: 'rules' | 'ai' | 'manual'; profileIdentityConfirmed: boolean;
    headline: string; about: string; profileLocation: string; latestPostText: string; lastActivityAt: string | null; activityStatus: 'Active' | 'Inactive' | 'Unknown'; linkedinUrl: string;
    activityEvidence?: {version:1|2;ignoredForeign?:number; endpoint:string; profileUrn:string; profileUrl:string; checkedAt:string; feedElements:number; unresolved:number; selected:ActivityRecord|null; records:ActivityRecord[]; reason:string}|null;
    website: string; websiteStatus: 'OWNED' | 'PROFILE_PLATFORM' | 'UNCONFIRMED' | 'NONE';
    segments: ProspectSegment[]; segment: ProspectSegment; facts: Record<FactKey, ProspectFact>;
    pages: { url: string; label: string; status: 'inspected' | 'blocked' | 'skipped'; note: string; attempts?: number; retryable?: boolean; contactPage?: boolean; hasDescription?: boolean }[]; limitations: string[];
    contacts: { address: string; source: 'linkedin' | 'website' | 'pattern_guess' | 'manual'; url: string; ownership: 'PUBLISHED' | 'DOMAIN_MATCH' | 'GUESSED' | 'UNCONFIRMED'; excerpt?:string }[];
    description: {url: string; text: string} | null;
    crawl: {version: number; attributionVersion?:number; complete: boolean; retryable?: boolean; attempted?: string[]; maxRoutes?: number; storageLimited?: boolean; visited: string[]; pending: string[]; failed: string[]; roots: string[]; matchedHosts: string[];contactMatchedHosts?:string[]; discovered: number; inspected: number; contactPages: number; descriptionPages: number; stoppedReason: string; candidates: {address: string; url: string; explicit: boolean; contactPage: boolean; businessContact?: boolean;contactInvitation?:boolean}[]} | null;
};
export type ActivityRecord={postUrn:string;authorUrn:string;at:string;method:string;association:string;text:string};
export type ProspectAssessment = {
    version: number; researchedAt: string; tier: ProspectTier; segment: ProspectSegment; segments: ProspectSegment[]; score: number;
    businessFit: 'MATCH' | 'POTENTIAL' | 'OUTSIDE_ICP' | 'UNKNOWN'; readiness: 'READY_TO_APPROACH' | 'EARLY' | 'NEEDS_REVIEW'; engagementReady: boolean;
    qualification: {policy: 'EMAIL_ACTIVITY_V1'|'EMAIL_ACTIVITY_FOLLOWERS_V2'|'EMAIL_ACTIVITY_FOLLOWERS_LOCATION_V3'; qualified: boolean; activity: 'RECENT' | 'INACTIVE' | 'UNKNOWN'; activityAgeDays: number | null; attributableEmail: boolean; needsRetry: boolean; needsAttention?: boolean;followers?:string;followersReason?:string|null;followersThreshold?:number;location?:string;locationReason?:string|null;locationCountry?:string|null};
    contact: { channel: 'EMAIL_READY' | 'EMAIL_NEEDS_VERIFICATION' | 'LINKEDIN_ONLY' | 'UNAVAILABLE' | 'OWNERSHIP_UNCLEAR'; ownership: string; email: string };
    blockers: string[]; unknowns: string[]; cautions: string[]; nextAction: string; research: ProspectResearch; baseResearch: ProspectResearch;
};
/** Evidence required by CRM contact gates; full research is unnecessary for lists. */
export type ProspectContactAssessment = Pick<ProspectAssessment, 'version' | 'score' | 'contact'> & {
    research: Pick<ProspectResearch, 'profileIdentityConfirmed' | 'lastActivityAt' | 'followers' | 'connections'> & Partial<Pick<ProspectResearch,'profileLocation'|'targetLocationRequired'>>;
};
export const VERSION: number;
export const QUALIFICATION_VERSION:number;
export type AudienceEvidence={rawText:string;count:number|null;checkedAt:string;threshold?:number};
export const RESEARCH_MAX_AGE_DAYS: number;
export const SEGMENTS: ProspectSegment[];
export const SEGMENT_LABELS: Record<ProspectSegment, string>;
export const DEFAULT_TITLES: string[];
export const FACT_KEYS: FactKey[];
export const FACT_LABELS: Record<FactKey, string>;
export const STATES: FactState[];
export const STATE_LABELS: Record<FactState, string>;
export const TIER_LABELS: Record<ProspectTier | 'UNREVIEWED', string>;
export function segmentsFromText(text: string): ProspectSegment[];
export function emptyResearch(input?: Record<string, unknown>, now?: string): ProspectResearch;
export function validateResearch(value: unknown): ProspectResearch;
export function validateReview(value: unknown): ProspectReview;
export function applyReview(research: ProspectResearch, review?: ProspectReview | null): ProspectResearch;
export function assessProspect(research: ProspectResearch, context?: { review?: ProspectReview | null; email?: string; emailProven?: boolean; now?: string;minFollowers?:number;legacyFollowersUnchecked?:boolean }): ProspectAssessment;
export function isContactNow(assessment?: ProspectContactAssessment | null): boolean;
export function hasAttributableEmail(assessment?: ProspectContactAssessment | null): boolean;
export function isQualifiedRecord(lead: { pipeline_status: string; email?: string; prospect_assessment?: ProspectContactAssessment | null }): boolean;
export function hasQualifiedEmail(lead: { pipeline_status: string; email?: string; prospect_assessment?: ProspectContactAssessment | null }): boolean;
export function pipelineForAssessment(assessment: ProspectAssessment): string;
export function isUnsafeContact(address: string): boolean;
export function isPlatformWebsite(url: string): boolean;
export function hostOf(url: string): string;
export function extractMatchingProfile(response: unknown, slug: string): Record<string, unknown> | null;
export function extractProfileLocation(response: unknown, slug: string): string;
export function extractProfileContactInfo(response: unknown, slug: string): Record<string, unknown>;
